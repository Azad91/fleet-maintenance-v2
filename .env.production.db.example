# ==============================================================================
# PostgreSQL — Production Credentials
# ==============================================================================
# Bu fayl `docker-compose.prod.yml` tərəfindən `env_file` kimi oxunur.
# Format MÜTLƏQ `KEY=VALUE` olmalıdır — shell script, here-string və ya
# başqa sintaksis Docker tərəfindən başa düşülmür.
#
# İstifadə:
#   1. Bu faylı kopyalayın:
#        cp .env.production.db.example .env.production.db
#   2. Aşağıdakı dəyərləri REAL production dəyərləri ilə əvəz edin.
#   3. .env.production.db faylını HEÇ VAXT git-ə commit etməyin.
#      (.gitignore-da artıq var)
# ==============================================================================

POSTGRES_DB=fleet_maintenance_production
POSTGRES_USER=fleet_prod
POSTGRES_PASSWORD=CHANGE_ME_WITH_STRONG_RANDOM_PASSWORD

# ────────────────────────────────────────────────────────────────
# BACKUP RETENTION
# ────────────────────────────────────────────────────────────────
# How many days of database backups to keep on disk. Older files
# are removed automatically by the nightly retention sweep.
#
# Sizing hint: a compressed dump of a mid-sized fleet database is
# typically 5-50 MB. 14 days of daily backups is well under 1 GB.
#
# For long-term retention, snapshot the ./backups directory to
# off-site storage (S3, Backblaze, rsync) — see README.
BACKUP_RETENTION_DAYS=14

# Hour of the day (00-23) when the backup runs. The host's timezone
# (usually UTC inside the container) determines the wall-clock time.
BACKUP_HOUR=02

# Parol yaratmaq üçün:
#   openssl rand -base64 32
# və ya
#   php -r "echo bin2hex(random_bytes(24)) . PHP_EOL;"
