<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/> 
        <!-- force="true" overrides any matching value in the project .env file.
             Without this, a dev .env that sets DB_DATABASE to the real dev
             database would cause RefreshDatabase to wipe it during test runs. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="fleet_maintenance_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>

        <!-- ════════════════════════════════════════════════════════
             LOG CHANNEL — tests never write to disk.
             
             The default `stack` channel writes to
             storage/logs/laravel.log. On Windows that file is often
             locked by an IDE or antivirus, and every Log::* call
             throws UnexpectedValueException. Using the `null` channel
             short-circuits the logger entirely.
             
             Tests that need to assert on log calls use Log::spy(),
             which intercepts before the channel is even consulted.
             ════════════════════════════════════════════════════════ -->
        <env name="LOG_CHANNEL" value="null"/>
    </php>
</phpunit>
