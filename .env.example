# ────────────────────────────────────────────────────────────────
# APPLICATION
# ────────────────────────────────────────────────────────────────
APP_NAME="Fleet Maintenance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ────────────────────────────────────────────────────────────────
# TRUSTED PROXIES
# ────────────────────────────────────────────────────────────────
# Leave empty for local dev. Set to specific IPs/CIDRs in production.
# NEVER use "*" — it allows IP spoofing and breaks rate limiting.
TRUSTED_PROXIES=

# ────────────────────────────────────────────────────────────────
# LOCALIZATION
# ────────────────────────────────────────────────────────────────
# Supported: en, az, tr, ru
# Default: en (falls back to fallback_locale if not available)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ────────────────────────────────────────────────────────────────
# PAGINATION
# ────────────────────────────────────────────────────────────────
# Rows per page in list views (default: 25)
APP_PAGINATION=25

# ────────────────────────────────────────────────────────────────
# MAINTENANCE
# ────────────────────────────────────────────────────────────────
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# ────────────────────────────────────────────────────────────────
# SECURITY
# ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ────────────────────────────────────────────────────────────────
# LOGGING
# ────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fleet_maintenance
DB_USERNAME=postgres
DB_PASSWORD=

# ────────────────────────────────────────────────────────────────
# SESSION
# ────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ────────────────────────────────────────────────────────────────
# CACHE / QUEUE / FILESYSTEM
# ────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ────────────────────────────────────────────────────────────────
# MEMCACHED (optional)
# ────────────────────────────────────────────────────────────────
MEMCACHED_HOST=127.0.0.1

# ────────────────────────────────────────────────────────────────
# REDIS (optional)
# ────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ────────────────────────────────────────────────────────────────
# MAIL
# ────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ────────────────────────────────────────────────────────────────
# AWS (optional)
# ────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ────────────────────────────────────────────────────────────────
# FRONTEND
# ────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ────────────────────────────────────────────────────────────────
# SANCTUM (API tokens)
# ────────────────────────────────────────────────────────────────
# Token lifetime in minutes. Default: 43200 (30 days).
SANCTUM_EXPIRATION=43200

# Comma-separated list of domains that receive stateful API sessions.
# In production, add your real domain (e.g. "fleet.yourdomain.com").
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

# ────────────────────────────────────────────────────────────────
# SENTRY (error tracking — optional)
# ────────────────────────────────────────────────────────────────
# Leave SENTRY_LARAVEL_DSN empty to disable Sentry entirely —
# no events are sent, no network calls are made. Enable per
# environment by setting the DSN in that environment's .env file.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
