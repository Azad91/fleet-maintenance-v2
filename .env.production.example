# ==============================================================================
# FLEET MAINTENANCE SYSTEM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

APP_NAME="Fleet Maintenance"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://fleet.yourdomain.com
TRUSTED_PROXIES=
APP_TIMEZONE=Asia/Baku
APP_LOCALE=az
APP_FALLBACK_LOCALE=en

# LOGGING
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# DATABASE (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fleet_maintenance_production
DB_USERNAME=fleet_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD
DB_SSLMODE=prefer

# SESSION & COOKIES
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# BROADCAST & CACHE
BROADCAST_CONNECTION=log
CACHE_STORE=database
CACHE_PREFIX=fleet_cache_

# QUEUE
QUEUE_CONNECTION=database

# MAIL
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@fleet.yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# SECURITY & RATE LIMITING
RATE_LIMIT_LOGIN=5,1
RATE_LIMIT_API=60,1
RATE_LIMIT_PDF=10,1
RATE_LIMIT_IMPORT=5,1

# STORAGE
FILESYSTEM_DISK=local

