# ==============================================================================
# SUPER ADMIN BOOTSTRAP
# ==============================================================================
# If set, this password is used the FIRST TIME the Super Admin is seeded.
# If unset in production, a strong random password is generated and
# printed once to the console. Ignored if the Super Admin already exists.
# Leave empty if you prefer random generation.
SUPER_ADMIN_PASSWORD=

APP_NAME="Fleet Maintenance"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://fleet.yourdomain.com
# ────────────────────────────────────────────────────────────────────────
# TRUSTED PROXIES
# ────────────────────────────────────────────────────────────────────────
# Laravel yalnız bu IP-lərdən gələn X-Forwarded-* header-lərinə inanır.
# Boş buraxsan (lokal dev/test üçün düzgündür) — heç bir header etibarlı
# sayılmır və rate-limiting real müştəri IP-si əvəzinə proxy-nin IP-sini
# görür.
#
# Ssenariyə uyğun DƏYƏRLƏR:
#   • Nginx eyni serverdə:        TRUSTED_PROXIES=127.0.0.1
#   • Nginx ayrı Docker-də:       TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8
#   • Cloudflare:                 TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22
#   • AWS ALB / GCP LB:           TRUSTED_PROXIES=10.0.0.0/8
#
# ⚠️  HEÇ VAXT "*" yazma production-da. Bu, istənilən istifadəçinin real
#     IP-ni saxtalaşdırmasına imkan verir və rate-limiting-i tamamilə
#     sıradan çıxarır.
TRUSTED_PROXIES=
APP_TIMEZONE=Asia/Baku
APP_LOCALE=az
APP_FALLBACK_LOCALE=en

# ────────────────────────────────────────────────────────────────────────
# HEALTH ENDPOINT
# ────────────────────────────────────────────────────────────────────────
# /health is public in the application (no auth) so external monitoring
# tools can reach it. Restrict it at the reverse-proxy level so anonymous
# visitors cannot read your queue driver, disk usage, and backup age.
#
# See docker/nginx/fleet.conf.example for a ready-to-adapt Nginx config
# with an "allow <private ranges>; deny all;" block on /health.
#
# If your monitor runs from a dynamic IP (UptimeRobot free tier,
# Cloudflare health checks), whitelisting is impossible — use a shared
# secret query string instead and add an nginx `if ($arg_token != ...)`
# guard.
#
# Disable the individual backup-freshness probe (e.g. if you do not run
# the backup sidecar) by setting HEALTH_BACKUP_MAX_AGE_HOURS=0.
HEALTH_BACKUP_MAX_AGE_HOURS=25

# ────────────────────────────────────────────────────────────────────────

# LOGGING
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# DATABASE (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fleet_maintenance_production
DB_USERNAME=fleet_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD
DB_SSLMODE=prefer

# SESSION & COOKIES
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# BROADCAST & CACHE
BROADCAST_CONNECTION=log
CACHE_STORE=database
CACHE_PREFIX=fleet_cache_

# QUEUE
QUEUE_CONNECTION=database

# MAIL
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@fleet.yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# SECURITY & RATE LIMITING
#
# Format: "<attempts>,<decay_minutes>"
# Nümunə: "5,1" = 1 dəqiqə ərzində 5 cəhd
#
RATE_LIMIT_LOGIN=5,1
RATE_LIMIT_API=60,1
RATE_LIMIT_PDF=10,1
RATE_LIMIT_IMPORT=5,1

# Login lockout (email + PIN login üçün ayrı mexanizm)
# 5 səhv cəhddən sonra 15 dəqiqə blok
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_DECAY=900

# STORAGE
FILESYSTEM_DISK=local

# API TOKEN EXPIRATION (minutes)
SANCTUM_EXPIRATION=43200
